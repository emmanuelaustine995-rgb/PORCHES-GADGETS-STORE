PORT=3000
DATA_DIR=/data
ADMIN_KEY=replace-with-a-long-random-secret-at-least-16-characters
# Daraja credentials — keep these only in Northflank secrets/environment variables
MPESA_ENV=sandbox
MPESA_KEY=
MPESA_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Buy Goods/Till use MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline and set MPESA_PARTY_B
MPESA_PARTY_B=
PUBLIC_URL=https://YOUR-NORTHFLANK-DOMAIN
CALLBACK_SECRET=replace-with-a-long-random-callback-secret
